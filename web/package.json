{
  "name": "sigil-v2-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-research-checkpoint.mjs && node scripts/check-company-growth.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "studies:candidate:generate": "node scripts/intake-study.mjs generate",
    "studies:candidate:check": "node scripts/intake-study.mjs check",
    "studies:candidate:test": "node --test scripts/intake-study.test.mjs scripts/intake-receipt.test.mjs scripts/intake-workflow.test.mjs",
    "studies:catalog:test": "node --test scripts/study-catalog-review.test.mjs scripts/export-experiments.test.mjs tests/studies.test.mjs scripts/research-updates.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  }
}
